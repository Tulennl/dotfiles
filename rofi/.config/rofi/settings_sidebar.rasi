configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: false;
}

@import "shared/colors.rasi"

window {
    background-color: @bg;
    border: 1px;
    border-color: @window-border;
    border-radius: 20px;
    
    width: 25%;
    height: 85%;
    
    location: north west;
    anchor: north west;
    x-offset: 12px;
    y-offset: 54px;
}

mainbox {
    background-color: transparent;
    padding: 25px;
    children: [ mode-switcher, inputbar, listview ];
}

mode-switcher {
    background-color: transparent;
    spacing: 10px;
    margin: 0px 0px 15px 0px;
}

button {
    background-color: @card-bg;
    border: 1px;
    border-color: @card-border;
    text-color: #a0a0a0;
    border-radius: 12px;
    padding: 8px 0px;
    horizontal-align: 0.5;
}

button selected {
    background-color: @selected;
    text-color: @accent;
    border-color: rgba(255, 255, 255, 0.15);
}

inputbar {
    background-color: @card-bg;
    border: 1px;
    border-color: @card-border;
    border-radius: 12px;
    padding: 10px 15px;
    margin: 0px 0px 15px 0px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Поиск...";
    placeholder-color: rgba(255, 255, 255, 0.3);
}

listview {
    background-color: transparent;
    columns: 1;
    spacing: 8px;
    cycle: true;
    dynamic: true;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 12px;
    padding: 12px 15px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element selected {
    background-color: @selected;
    text-color: @accent;
}
